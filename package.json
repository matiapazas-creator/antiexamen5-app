{
  "name": "antiexamen5",
  "productName": "ANTI.EXAMEN5",
  "version": "1.1.0",
  "description": "Navegador seguro con burbuja para rendir exámenes supervisados por ANTI.EXAMEN5 (Windows, Mac y Linux)",
  "author": {
    "name": "ANTI.EXAMEN5",
    "email": "no-responder@antiexamen5.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.antiexamen5.app",
    "productName": "ANTI.EXAMEN5",
    "copyright": "ANTI.EXAMEN5",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "permitidos.js",
      "preload.js",
      "examen-preload.js",
      "burbuja.html",
      "burbuja.js",
      "burbuja-preload.js",
      "sin-conexion.html",
      "sin-conexion.js",
      "estilos.css",
      "fuentes/**",
      "package.json",
      "build/icon.png"
    ],
    "protocols": [
      {
        "name": "ANTI.EXAMEN5",
        "schemes": [
          "antiexamen5"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "ANTI.EXAMEN5",
      "artifactName": "ANTI-EXAMEN5-Windows.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ANTI.EXAMEN5",
      "deleteAppDataOnUninstall": true,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    },
    "publish": null,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-1024.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "ANTI-EXAMEN5-Mac.${ext}",
      "minimumSystemVersion": "11.0"
    },
    "dmg": {
      "title": "ANTI.EXAMEN5",
      "artifactName": "ANTI-EXAMEN5-Mac.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-1024.png",
      "category": "Education",
      "artifactName": "ANTI-EXAMEN5-Linux.${ext}",
      "synopsis": "Navegador seguro para exámenes supervisados",
      "maintainer": "ANTI.EXAMEN5 <no-responder@antiexamen5.com>",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "ANTI-EXAMEN5-Linux.${ext}"
    }
  },
  "homepage": "https://antiexamen5.com",
  "desktopName": "antiexamen5.desktop"
}
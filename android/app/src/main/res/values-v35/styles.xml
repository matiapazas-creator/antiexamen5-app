<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 dibuja bajo la barra de estado por defecto: aqui se pide el
         comportamiento clasico para que la barra del examen no quede tapada. -->
    <style name="Tema" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/urdimbre</item>
        <item name="android:statusBarColor">@color/urdimbre</item>
        <item name="android:navigationBarColor">@color/urdimbre</item>
        <item name="android:colorAccent">@color/maiz</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
